{
  "expo": {
    "name": "EcoTrack",
    "slug": "EcoTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.fiap.ecotrack"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "br.com.fiap.ecotrack",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O EcoTrack usa a câmera para registrar a foto que comprova a roçada.",
          "photosPermission": "O EcoTrack acessa suas fotos para anexar a comprovação da roçada."
        }
      ]
    ]
  }
}
